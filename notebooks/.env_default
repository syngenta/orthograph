# Environment variables for database connection integration tests and notebooks.
#
# Copy this file to .env and fill in your actual connection details.
# .env is git-ignored and should NOT be committed to the repository.
#
# Default values below match a stock local Neo4j/Memgraph install on standard ports.

# Neo4j connection details
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Memgraph connection details
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
