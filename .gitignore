# Do not delete items from .gitignore.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Distribution / packaging
*.egg-info/
.eggs/
dist/

# IDE settings Pycharm/VSCode/Visual Studio
.idea
.vscode
*.sln

# pytest
.pytest_cache
pytest-report.xml

# IPython Notebook
.ipynb_checkpoints

# Sphinx documentation
docs/build/
docs/source/reference/generated/*rst
# notebooks/ under source is a symlink (Linux) or copy (Windows) — never committed
docs/source/notebooks/
docs/jupyter_execute/notebooks/

# managing secrets
.secrets.*
.env

# Virtual environments
venv/
env/
.venv/
.env/

# Logs
*.log
logs/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Mypy cache
.mypy_cache/

# Ruff cache
.ruff_cache/

# Hypothesis testing cache
.hypothesis/

# OpenCode temp planning artefacts (never commit)
.opencode/
